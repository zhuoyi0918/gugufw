#!name=咕咕云 防火墙自动加白
#!desc=安装后：配置 → 模块 → 长按本模块 → 编辑纯文本，把两处 tokens= 后的占位换成你的 ctecsfw_ token，home= 后填家里 Wi-Fi 名（SSID）。家里 Wi-Fi 自动占槽 0、蜂窝占槽 1、其他 Wi-Fi 占槽 2，互不覆盖。
#!author=Nellstar

[Rule]
# 加白请求必须直连，服务端才能看到本机真实出口 IP
DOMAIN,www.guguyun.com,DIRECT
IP-CIDR,69.165.68.160/32,DIRECT,no-resolve

[Script]
gugu-fw-cron = type=cron,cronexpr="*/10 * * * *",script-path=https://raw.githubusercontent.com/zhuoyi0918/gugufw/main/scripts/gugu-firewall-whitelist.js,timeout=60,argument=tokens=在此填入ctecsfw_token&home=在此填入家里WiFi名
gugu-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/zhuoyi0918/gugufw/main/scripts/gugu-firewall-whitelist.js,timeout=60,argument=tokens=在此填入ctecsfw_token&home=在此填入家里WiFi名
