#!name=咕咕云 防火墙自动加白
#!desc=安装后：配置 → 模块 → 长按本模块 → 编辑纯文本，把下面 argument=tokens= 后的占位换成你的 ctecsfw_ token（控制台「复制白名单链接」里 token= 后面那段；多台机器用 | 分割；末尾加 @0~@4 可钉固定槽位）。
#!author=Nellstar

[Rule]
# 加白请求必须直连，服务端才能看到本机真实出口 IP
DOMAIN,www.guguyun.com,DIRECT
IP-CIDR,69.165.68.160/32,DIRECT,no-resolve

[Script]
gugu-fw-cron = type=cron,cronexpr="*/10 * * * *",script-path=https://raw.githubusercontent.com/zhuoyi0918/gugufw/main/scripts/gugu-firewall-whitelist.js,timeout=60,argument=tokens=在此填入ctecsfw_token
gugu-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/zhuoyi0918/gugufw/main/scripts/gugu-firewall-whitelist.js,timeout=60,argument=tokens=在此填入ctecsfw_token
